# Copy this file to .env.local (for local dev) and .env.production (for the
# build you upload to your hosting). These are all NEXT_PUBLIC_ variables,
# meaning they get baked into the static JS at build time — that's expected
# for a static-export site with no server.

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Your Calendly scheduling link, e.g. https://calendly.com/mick-magickmedia/adviesgesprek
NEXT_PUBLIC_CALENDLY_URL=

# The final public URL of this site, e.g. https://sea.magickmedia.nl
NEXT_PUBLIC_SITE_URL=https://sea.magickmedia.nl
